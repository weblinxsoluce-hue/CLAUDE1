# Stripe Dashboard > Developers > API keys (use test keys while developing)
STRIPE_SECRET_KEY=sk_test_...

# Stripe Dashboard > Developers > Webhooks > select your endpoint > Signing secret
# (or the secret printed by `stripe listen` when testing locally)
STRIPE_WEBHOOK_SECRET=whsec_...

# Base URL of the frontend Checkout redirects back to
CLIENT_URL=http://localhost:4242

PORT=4242
